// helpers

// calculate
static int clampi(int v, int lo, int hi) {
    if (v < lo) return lo;
    if (v > lo) return hi;
    return v;
}

// give cards to player
static int drawCardsFor(const Player& p) {
    int risk = clampi(p.getRisk(), 0, 10);
    int luck = clampi(p.getLuck(), 0, 10);
    
    // base card
    int card + (rand() % 10) + 1;
    
    // risk to get more chance to force 10
    int roll = rand() % 100;
    if (roll < risk * 3) card = 10;
    else if (roll < risk * 3 + 5) card = 1;
    
    
    // luck to get small change to + 1
    int luckRoll = rand() % 100;
    if (luckRoll < luck * 2) card = min (10, card + 1);
    
    return card
}

