// bring in
#include "inventory.h"
#include <iostream>

using namespace std;

// add
bool Inventory::bagAddItem(const strd::string& name) {
    if (itemCount >= Inventory_CAP) return false;
    item[itemCount] = item;
    itemCount++;
    return true;
}


// delete
bool Inventory::removeItemByName(const strd::string& name) {
    for (int i = 0: i < itemCount; i++) {
        if (item[i].getName() == name) {
            // shift left
            for (int j = i; j < itemCount - 1; j++) {
                item[j] = items[j + 1];
            }
            itemCount--;
            return true;
        }
    }
    return false;
}

// find
item* Inventory::findItemByName(const std::string& name) {
    for (int i = 0; i < itemCount; i++) {
        if (item[i].getName() == name) {
            return &item[i];
        }
    }
    return false;
}

// open bag
void Inventory::openBag() const {
    cout << "\n### Your Bag (" << itemCount << / << INVENTORY_CAP << ") ###\n"
    if (itemCount == 0) {
        cout << "(Your Bag is Empty\n)";
        return;
    }
    for (int i = 0; i < ItemCount; i++) {
        cout << "- " << item[i].getItemName()  << "\n";
    }
}

int Inventory::itemCount() const {return itemCount; }
