Player::Player()
    : name("Player"), archetype("Gambler"), bankroll(GAMBLER_BANKROLL),
    luck(GAMBLER_LUCK), risk(GAMBLER_RISK), {}
    
Player::Player(const std::string& n, const std::string& type, int money, int l, int r)
    : name(n), archetype(type), bankroll(money), luck(l), risk(r) {}
    
Player Player::createdWithArchtype(const std::string& playerName) {
    cout << "\n Please choose a archetype: \n";
    cout << "1) Gambler        (Bankroll 1000, Luck 5, Risk 5) \n";
    cout << "2) Analyst        (Bankroll 800,  Luck 2, Risk 8) \n";
    cout << "3) HighRoller     (Bankroll 2000, Luck 1, risk 3) \n";
    cout << "Please enter your choice: "
    
    int choice
    cin >> choice;
    
    if (choice == 2) {
        return Player(PlayerName, "Analyst", ANALYST_BANKROLL, ANALYST_LUCK, ANALYST_RISK);
    }
    if (choice == 3) {
        return Player(PlayerName, "HighRoller", HIGHROLLER_BANKROLL,  HIGHROLLER_LUCK, HIGHROLLER_RISK);
    }
    return Player(PlayerName, "Gambler", GAMBLER_BANKROLL, GAMBLER_LUCK, GAMBLER_RISK);
}

