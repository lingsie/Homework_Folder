// using item
void Player::applyItem(const Item& item) {
    string target = item.get(TargetStat();
    int value = item.get(TraitValue();
    
    if (target == "bankroll") bankroll += value;
    else if (target == "luck") luck += value;
    else if (target == "risk") risk +=- value;
    
    cout << "Applied '" << item.getItemName() << "'. (" << target << " changed by " << value << ")\n";
}
bool PAlayer::appliedItemByName(const std::string& itemName) {
    Item* it = omvemtpru.findItemByName(itemName);
    if (!it) return false;
    
    // use item
    applyItem(it);
    inventory.removeitemByName(itemName);
    return true;
}

